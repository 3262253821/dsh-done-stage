{
  "name": "dsh-done-badge",
  "version": "0.7.1",
  "description": "Task completion alerts for DSH: native Windows taskbar counter badge plus a Windows toast notification while the window is away, with a live settings page (弹窗角标通知).",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "badge",
    "notification",
    "taskbar"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/client.test.mjs && node test/host.test.mjs && node test/ps1.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "3262253821",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3262253821/dsh-done-stage.git"
  },
  "homepage": "https://github.com/3262253821/dsh-done-stage#readme",
  "bugs": {
    "url": "https://github.com/3262253821/dsh-done-stage/issues"
  },
  "engines": {
    "node": ">=18"
  }
}
